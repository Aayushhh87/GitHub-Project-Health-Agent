# Optional GitHub token for higher GitHub REST API rate limits.
GITHUB_TOKEN=

# OpenRouter API key for Milestone 5 AI synthesis. When unset, scoring still runs.
OPENROUTER_API_KEY=

# Optional model override (default: openai/gpt-4o-mini).
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional comma-separated origins for local frontend development.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

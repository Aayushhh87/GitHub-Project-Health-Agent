# Optional GitHub token for higher GitHub REST API rate limits.
GITHUB_TOKEN=

# Gemini API key for Milestone 5 AI synthesis. When unset, scoring still runs.
GEMINI_API_KEY=

# Optional model override (default: gemini-2.0-flash).
GEMINI_MODEL=gemini-2.0-flash

# Optional comma-separated origins for local frontend development.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
